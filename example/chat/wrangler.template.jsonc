{
    // Worker name + entry. The default export of `src/server/worker.ts` is the
    // wrapped `mountChardb` fetch handler; the `WorkerEntrypoint` subclass
    // (`Chardb` from `defineChardb`) lives there too.
    "name": "chardb-chat-example",
    "main": "src/server/worker.ts",
    "compatibility_date": "2025-09-01",
    "compatibility_flags": ["nodejs_compat"],

    // Static assets binding — `vite build` writes the React SPA into ./dist,
    // wrangler serves any file under there ahead of `app.fetch`. The live
    // chardb routes (`/ws` and `/_chardb/*`) run through the Worker first.
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/ws", "/_chardb/*"]
    },

    "durable_objects": {
        "bindings": [
            // Per-tenant SQLite shards. The op-log dedup wrapper + transactionSync
            // run here; user mutation closures execute inside a Cdb DO.
            { "name": "CDB_SHARD", "class_name": "Cdb" },
            // Range table + epoch + barrier coordinator. One global instance per DB.
            { "name": "CDB_CATALOG", "class_name": "Catalog" },
            // Hibernatable WebSocket gateway: subscriptions, presence, mut routing.
            { "name": "CDB_GATEWAY", "class_name": "Gateway" },
            // R2 blob refcount + status lifecycle for `chardb/files`.
            { "name": "CDB_BLOBMETA", "class_name": "BlobMeta" },
            // Online vshard split driver. Idle until a migration is opened.
            { "name": "CDB_RESHARDER", "class_name": "Resharder" },
            // Eventually-consistent secondary indexes (defineGsi).
            { "name": "CDB_GSI", "class_name": "GsiShard" }
        ]
    },

    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Cdb", "Catalog", "Gateway", "BlobMeta", "Resharder", "GsiShard"] }
    ],

    // Tail-capture queue for GSI write fan-out.
    "queues": {
        "producers": [{ "queue": "chardb-gsi", "binding": "CDB_GSI_QUEUE" }],
        "consumers": [{ "queue": "chardb-gsi", "max_batch_size": 100 }]
    },

    // Optional: blob storage and vector index for `chardb/files` and `vector()`.
    "r2_buckets": [{ "binding": "CDB_R2", "bucket_name": "chardb-chat-blobs" }],
    "vectorize": [{ "binding": "CDB_VECTORIZE", "index_name": "chardb-chat" }],

    // PITR barrier tick (every minute) + user defineCron callbacks dispatch.
    "triggers": { "crons": ["* * * * *"] }
}
