{
    "name": "chardb",
    "version": "0.1.0",
    "description": "Cloudflare-native SQL with per-tenant ACID and live Drizzle queries",
    "type": "module",
    "license": "MIT",
    "homepage": "https://chardb.dev",
    "repository": "github:chardb/chardb",
    "bin": {
        "chardb": "./dist/cli/bin.mjs"
    },
    "files": ["dist", "src", "README.md"],
    "workspaces": ["landing"],
    "scripts": {
        "build": "unbuild",
        "build:stub": "unbuild --stub",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write ."
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server/index.d.mts",
            "import": "./dist/server/index.mjs"
        },
        "./drizzle": {
            "types": "./dist/drizzle/index.d.mts",
            "import": "./dist/drizzle/index.mjs"
        },
        "./files": {
            "types": "./dist/files/index.d.mts",
            "import": "./dist/files/index.mjs"
        },
        "./files/zod": {
            "types": "./dist/files/validators/zod.d.mts",
            "import": "./dist/files/validators/zod.mjs"
        },
        "./files/typebox": {
            "types": "./dist/files/validators/typebox.d.mts",
            "import": "./dist/files/validators/typebox.mjs"
        },
        "./files/valibot": {
            "types": "./dist/files/validators/valibot.d.mts",
            "import": "./dist/files/validators/valibot.mjs"
        },
        "./files/arktype": {
            "types": "./dist/files/validators/arktype.d.mts",
            "import": "./dist/files/validators/arktype.mjs"
        },
        "./auth": {
            "types": "./dist/auth/index.d.mts",
            "import": "./dist/auth/index.mjs"
        },
        "./react": {
            "types": "./dist/react/index.d.mts",
            "import": "./dist/react/index.mjs"
        },
        "./cli": {
            "types": "./dist/cli/index.d.mts",
            "import": "./dist/cli/index.mjs"
        },
        "./vite": {
            "types": "./dist/vite/index.d.mts",
            "import": "./dist/vite/index.mjs"
        },
        "./miniflare-plugin": {
            "types": "./dist/miniflare-plugin/index.d.mts",
            "import": "./dist/miniflare-plugin/index.mjs"
        },
        "./observability": {
            "types": "./dist/observability/index.d.mts",
            "import": "./dist/observability/index.mjs"
        },
        "./reshard": {
            "types": "./dist/reshard/index.d.mts",
            "import": "./dist/reshard/index.mjs"
        },
        "./eslint-plugin": {
            "types": "./dist/eslint-plugin/index.d.mts",
            "import": "./dist/eslint-plugin/index.mjs"
        }
    },
    "peerDependencies": {
        "drizzle-orm": ">=0.36.0",
        "better-auth": "~1.6.10",
        "react": ">=18.0.0",
        "drizzle-zod": ">=0.8.0",
        "drizzle-typebox": ">=0.1.0",
        "drizzle-valibot": ">=0.2.0",
        "drizzle-arktype": ">=0.1.0",
        "zod": ">=3.25.0",
        "@sinclair/typebox": ">=0.32.0",
        "valibot": ">=0.30.0",
        "arktype": ">=2.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "better-auth": {
            "optional": true
        },
        "drizzle-zod": {
            "optional": true
        },
        "drizzle-typebox": {
            "optional": true
        },
        "drizzle-valibot": {
            "optional": true
        },
        "drizzle-arktype": {
            "optional": true
        },
        "zod": {
            "optional": true
        },
        "@sinclair/typebox": {
            "optional": true
        },
        "valibot": {
            "optional": true
        },
        "arktype": {
            "optional": true
        }
    },
    "dependencies": {
        "@noble/hashes": "^1.5.0",
        "jose": "^6.1.3",
        "ulid": "^2.3.0",
        "uuidv7": "^1.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@cloudflare/workers-types": "^4.20251005.0",
        "@types/bun": "^1.1.13",
        "@types/react": "^18.3.12",
        "@types/react-test-renderer": "^18.3.0",
        "better-auth": "~1.6.10",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "0.8.3",
        "hono": "^4.6.0",
        "miniflare": "^4.20260507.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "react-test-renderer": "^18.3.1",
        "typescript": "^5.6.3",
        "unbuild": "^3.6.1",
        "zod": "^4.0.0"
    }
}
