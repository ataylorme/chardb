{
    "compilerOptions": {
        "lib": ["ES2023", "DOM"],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["@cloudflare/workers-types"]
    },
    "include": ["src/**/*"]
}
