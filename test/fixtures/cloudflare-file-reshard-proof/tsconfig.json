{
    "compilerOptions": {
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": {
            "@chardb/core": ["../../../src/index.ts"],
            "@chardb/core/files": ["../../../src/files/index.ts"],
            "@chardb/core/server": ["../../../src/server/index.ts"]
        },
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["@cloudflare/workers-types"]
    },
    "include": ["src/**/*.ts"]
}
