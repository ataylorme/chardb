{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "lib": ["ES2023"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "outDir": "./.tsbuild/node",
        "tsBuildInfoFile": "./.tsbuild/tsconfig.node.tsbuildinfo",
        "strict": true
    },
    "include": ["vite.config.ts", "tailwind.config.ts", "postcss.config.js"]
}
